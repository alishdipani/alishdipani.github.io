---
// Self-hosted fonts (latin subset, only the weights in use).
import '@fontsource/nunito-sans/latin-400.css';
import '@fontsource/nunito-sans/latin-600.css';
import '@fontsource/nunito-sans/latin-700.css';
import '@fontsource/source-serif-4/latin-400.css';
import '@fontsource/source-serif-4/latin-400-italic.css';
import '@fontsource/source-serif-4/latin-600.css';
import '@fontsource/source-code-pro/latin-400.css';
import '../styles/global.css';
import { SITE, NAV, PREVIEW, url, type Credit } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  // Footer credit lines for the images the page shows (Blog list, posts with an NGC image).
  credits?: Credit[];
  // Posts lay out their own wider grid (sticky contents, margin notes).
  wide?: boolean;
  // Link previews (Open Graph): an image path and the page type.
  image?: string;
  type?: 'website' | 'article';
}
const { title, description = SITE.description, noindex = false, credits = [], wide = false, image, type = 'website' } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.name}` : SITE.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const isHome = path === url('/');
const isCurrent = (href: string) => path.startsWith(url(href));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {(PREVIEW || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    {image && <meta property="og:image" content={new URL(url(image), Astro.site)} />}
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="data:," />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} · Blog`} href={url('/feed.xml')} />
    <slot name="head" />
    <script is:inline>
      // Apply the reader's stored theme before the page paints (no flash of the wrong theme).
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <header class="site-header">
      {isHome ? <span class="site-name">{SITE.name}</span> : <a class="home-link" href={url('/')}>← Home</a>}
      <div class="header-end">
        <nav aria-label="Main">
          {NAV.map((item) => (
            <a href={url(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
        <button type="button" class="theme-toggle" data-theme-toggle>
          <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
          <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
          <span class="sr-only">Switch to dark theme</span>
        </button>
      </div>
    </header>
    <main class:list={[wide && 'main-post']}>
      <slot />
    </main>
    <footer class="site-footer">
      {credits.map((c) => (
        // Credit wording is required by the image licenses; keep it exactly as is.
        <p>{c.label}: {c.linkText && c.text.startsWith(c.linkText)
          ? <><a href={c.href}>{c.linkText}</a>{c.text.slice(c.linkText.length)}</>
          : <a href={c.href}>{c.text}</a>}</p>
      ))}
      <p>© {new Date().getFullYear()} {SITE.name} · Built with <a href="https://astro.build">Astro</a>, with help from Claude</p>
    </footer>
    <script>
      // Light/dark toggle: follows the system until the reader chooses, then remembers the choice.
      const root = document.documentElement;
      const system = matchMedia('(prefers-color-scheme: dark)');
      const current = () => (root.dataset.theme as 'light' | 'dark' | undefined) ?? (system.matches ? 'dark' : 'light');
      for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
        const label = btn.querySelector('.sr-only')!;
        const sync = () => {
          const next = current() === 'dark' ? 'light' : 'dark';
          label.textContent = `Switch to ${next} theme`;
          btn.title = `Switch to ${next} theme`;
        };
        btn.addEventListener('click', () => {
          const next = current() === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try { localStorage.setItem('theme', next); } catch {}
          sync();
        });
        system.addEventListener('change', sync);
        sync();
      }
    </script>
  </body>
</html>
