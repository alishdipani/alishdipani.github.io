---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, url, imageCredits } from '../../lib/site';


const posts = await getPosts();
const credits = imageCredits(posts.map((p) => (p.data.ngc?.thumb ? p.data.ngc : undefined)));
---
<Base title="Blog" credits={credits}>
  <h1 class="sr-only">Blog</h1>
  <!-- Wording: Alish's decision (Command Center, Oct 21 15:34). -->
  <p class="page-note">
    All posts written by me (a human). Each idea is paired with a New General Catalogue object&nbsp;(<a href={url('/blog/ngc/')}>why?</a>)
  </p>
  <PostList posts={posts} />
</Base>

