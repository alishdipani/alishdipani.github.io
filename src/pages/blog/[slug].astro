---
import 'katex/dist/katex.min.css';
import '../../styles/post.css';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import HoverCards from '../../components/HoverCards.astro';
import Contents from '../../components/Contents.astro';
import { getPosts, formatDate, url, imageCredits, SITE } from '../../lib/site';
import { excerpt } from '../../lib/excerpt';

export async function getStaticPaths() {
  const posts = await getPosts({ unlisted: true });
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const { title, date, description, ngc, unlisted } = post.data;
// Numbered table of contents from the ## headings (back matter excluded).
const toc = headings.filter((h) => h.depth === 2 && !['footnote-label', 'bib-references'].includes(h.slug));
const hasToc = toc.length > 1;
const items = toc.map((h) => ({ slug: h.slug, text: h.text.replace(/#$/, '') }));
// Meta description and link preview: the post's description, else the start of its first paragraph.
const metaDescription = description ?? excerpt(post.body);
// Footer credit: Legacy Surveys for pipeline images, the image's own credit for manual ones
// (the demo's placeholder gets none).
const credits = imageCredits([ngc]);
---
<Base title={title} description={metaDescription} image={ngc?.image} imageAlt={ngc ? `${ngc.name}, ${ngc.description}` : undefined} type="article" noindex={unlisted} credits={credits} wide>
  <div class:list={['post-layout', 'post-page', hasToc && 'has-toc']}>
    {hasToc && <Contents items={items} variant="side" />}

    <article class="post" data-post={post.id}>
      <div class="post-top">
        <a href={url('/blog/')}>← Blog</a>
      </div>

      <header class:list={['post-head', ngc && 'has-ngc']}>
        <div>
          <h1 class="post-title">{title}</h1>
          <time class="post-date" datetime={date.toISOString()}>{formatDate(date)}</time>
        </div>
        {ngc && (
          <figure class="post-ngc">
            <img src={url(ngc.image)} alt={`${ngc.name}, ${ngc.description}`} width="240" height="240" />
            <figcaption>
              {ngc.captionPrefix && <span>{ngc.captionPrefix}</span>}
              <a href={ngc.captionUrl ?? ngc.objectUrl}>{ngc.caption ?? ngc.name}</a>
            </figcaption>
          </figure>
        )}
      </header>

      {hasToc && <Contents items={items} variant="inline" />}

      <div class="post-body">
        <Content />
      </div>

      <!-- Ending line on every post (Alish, Oct 22 21:38). The email link copies the address; mailto stays as the fallback. -->
      <p class="post-end">
        Thoughts or ideas?{' '}
        <a href={`mailto:${SITE.email}`} data-copy-email={SITE.email}>Email me</a><span class="copied" role="status" aria-live="polite"></span>{' '}
        or find me on <a href={SITE.x} target="_blank" rel="noopener" data-event="profile-click" data-event-profile="x">X</a>.
      </p>
    </article>
  </div>
  <HoverCards />
</Base>

<style>
  .post-end { margin: var(--s3) 0 0; font: 0.9rem/1.5 var(--font-ui); color: var(--muted); }
  .post-end a { text-decoration-line: underline; }
  .post-end .copied:not(:empty) { margin-left: 0.4rem; color: var(--text); }
</style>

<script>
  import { track } from '../../lib/track';
  import { copyEmailOnClick } from '../../lib/copy-email';

  // "Email me" copies the address (no analytics event for the copy; if the mail app opens instead, email-click).
  copyEmailOnClick(document.querySelector('.post-end [data-copy-email]'), document.querySelector('.post-end .copied'), {
    fallback: () => track('email-click'),
  });

  // Analytics: blog-scroll once at each of 25, 50, 75 and 100% of the page scrolled (a page that fits on
  // the screen counts as fully read). Properties: post (slug) and depth.
  const post = document.querySelector<HTMLElement>('[data-post]')?.dataset.post ?? '';
  const left = [25, 50, 75, 100];
  const check = () => {
    const doc = document.documentElement;
    const seen = Math.min(100, ((window.scrollY + window.innerHeight) / doc.scrollHeight) * 100);
    while (left.length && seen >= left[0] - 0.5) track('blog-scroll', { post, depth: left.shift()! });
    if (!left.length) window.removeEventListener('scroll', onScroll);
  };
  let queued = false;
  const onScroll = () => {
    if (queued) return;
    queued = true;
    requestAnimationFrame(() => { queued = false; check(); });
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('load', check, { once: true });
</script>

