---
import Base from '../layouts/Base.astro';
import { url } from '../lib/site';

// Alish's CV, hosted on the site (added Oct 26; replaces the Aug 2024 Google Drive PDF).
const cvPdf = url('/cv/Alish_Dipani_CV.pdf');
// Analytics: cv-open means "opened the CV PDF" (an Umami goal uses it), so it is on every link to the PDF
// and nowhere else (not on the nav "CV" link, Oct 27). This button is the only such link.
---
<Base title="CV" description="CV of Alish Dipani (PDF).">
  <h1>CV</h1>
  <p><a class="button" href={cvPdf} data-event="cv-open">CV (PDF)</a></p>
</Base>
