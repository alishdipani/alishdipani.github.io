---
import Base from '../layouts/Base.astro';
import { NAV, BASE, getPosts, url } from '../lib/site';
import { loadRedirects } from '../lib/redirects.mjs';

// Fallback for anything that has no file: try the redirect table and a few
// path patterns of the old site, otherwise show links to the main pages.
const table = loadRedirects();
const slugs = (await getPosts()).map((p) => p.id);
---
<Base title="Page not found">
  <h1>Page not found</h1>
  <p>There is nothing at this address. Try one of these:</p>
  <ul>
    <li><a href={url('/')}>Home</a></li>
    {NAV.map((item) => <li><a href={url(item.href)}>{item.label}</a></li>)}
  </ul>
  <script is:inline define:vars={{ table, slugs, base: BASE }}>
    (function () {
      var p = decodeURIComponent(location.pathname);
      if (base && p.indexOf(base + '/') === 0) p = p.slice(base.length);
      p = p.replace(/\/index\.html$/, '/');
      if (!/\/$/.test(p) && !/\.[a-z0-9]+$/i.test(p)) p += '/';
      var to = table[p];
      if (!to) {
        var post = p.match(/^\/(?:gsoc2019|projects)\/\d{4}\/\d{2}\/(?:\d{2}\/)?([^/]+)\/$/);
        if (post && slugs.indexOf(post[1].toLowerCase()) !== -1) to = '/blog/' + post[1].toLowerCase() + '/';
        else if (/^\/blog\/(tag|category|page)\/|^\/blog\/\d{4}\/$/.test(p)) to = '/blog/';
        else if (/^\/news\//.test(p)) to = '/';
      }
      if (to && base + to !== location.pathname) {
        document.documentElement.dataset.redirecting = '';
        location.replace(base + to + location.search + location.hash);
      }
    })();
  </script>
  <script>
    import { track } from '../lib/track';
    // Analytics: a real "not found" (not an old address that the script above redirects).
    if (!('redirecting' in document.documentElement.dataset)) track('404', { path: location.pathname + location.search });
  </script>
</Base>
