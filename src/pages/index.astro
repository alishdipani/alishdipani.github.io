---
import Base from '../layouts/Base.astro';
import { formatDate, SITE, url } from '../lib/site';
import { getNews } from '../lib/news';

// Content finalized with Alish in Claude chat (Oct 22). Layout: two-frame hover cartoon beside the text,
// no name above the heading line, contact row under it, two directions, "Currently" line, then the blurb.
const headingLine = 'I study the visual perception and metacognition of AI models and agents, using human behavior and the brain as a reference.';
const internships = 'Actively looking for research internships in Summer and/or Fall 2027.';
const directions = [
  {
    label: 'Neuro & cognitive science for AI',
    text: 'Probing AI models and agents with controlled experiments from psychophysics and metacognition, and comparing their internal representations with the human brain.',
  },
  {
    label: 'AI for neuro & cognitive science',
    text: 'Building AI models that predict human brain activity and behavior, as well as agents that conduct in-silico experiments.',
  },
];
// "Currently" line (Alish, Oct 26): text before the link, the link, text after it. Its "(why?)" link to
// /blog/why-ai-safety/ is off while that post is a draft (Alish, Oct 29).
const currently = {
  before: "Lately, I've also been expanding into technical AI safety through ",
  link: { text: "Georgia Tech's AI Safety Initiative", href: 'https://www.aisi.dev/fellowships' },
  after: ', out of concern about the risks.',
};
// Blurb: plain strings and links (Alish's wording, Oct 22 22:54). Links open in a new tab; only these five are linked.
const blurb: (string | { text: string; href: string; event?: Record<string, string> })[] = [
  "I'm a NeuroAI PhD student at Georgia Tech, advised by ",
  { text: 'Apurva Ratan Murty', href: 'https://www.murtylab.com/' },
  ' and ',
  { text: 'Dobromir Rahnev', href: 'https://rahnevlab.gatech.edu/' },
  ', supported by the CoCo Fellowship from the ',
  { text: 'Center of Excellence in Computational Cognition', href: 'https://coco.psych.gatech.edu/' },
  '. My background is in computer science, vision science, and computational cognitive neuroscience. Previously, I did research at MIT Brain and Cognitive Sciences, Northeastern University, and CNRS, and worked as a machine learning engineer at Baylor College of Medicine. I also teach and create content for ',
  { text: 'Neuromatch Academy', href: 'https://neuroai.neuromatch.io/w1d5-tutorial2/' },
  ', and contribute to ',
  { text: 'open-source software', href: 'https://github.com/alishdipani', event: { 'data-event': 'profile-click', 'data-event-profile': 'github' } },
  '.',
];
const email = SITE.email;
const contact = [
  { label: 'Google Scholar', href: 'https://scholar.google.com/citations?user=i028n20AAAAJ', profile: 'scholar' },
  { label: 'GitHub', href: 'https://github.com/alishdipani', profile: 'github' },
  { label: 'X', href: 'https://x.com/alishdipani', profile: 'x' },
];

const news = getNews().slice(0, 5);

// SEO: the meta description is the heading line; the Person schema (JSON-LD) describes Alish for search engines.
const headlineDescription = headingLine;
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  jobTitle: 'PhD Student',
  affiliation: { '@type': 'CollegeOrUniversity', name: 'Georgia Institute of Technology', url: 'https://www.gatech.edu/' },
  url: 'https://alishdipani.github.io',
  image: new URL(SITE.ogImage.src, Astro.site).href,
  sameAs: [...SITE.sameAs, SITE.x], // + X, the profile the site links to
};
---
<Base description={headlineDescription}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(person)} />
  <div class="intro-wrap">
  <section class="intro">
    <figure class="cell photo">
      <img src={url('/assets/img/AlishDipani_picture.jpg')} alt={SITE.name} width="600" height="600" />
      <figcaption>Me (a human)</figcaption>
    </figure>
    <div class="cell top-text">
      <h1 class="intro-name">{SITE.name}</h1>
      <p class="intro-heading">{headingLine}</p>
      <p class="internships">{internships}</p>
      <nav class="contact" aria-label="Contact">
        <span><a href={`mailto:${email}`} data-copy-email={email}>Email</a> <span class="contact-email" data-copy-event="email-copy">{email}</span><span class="copied" role="status" aria-live="polite"></span></span>
        {contact.map((c) => <a href={c.href} data-event="profile-click" data-event-profile={c.profile}>{c.label}</a>)}
      </nav>
    </div>
    <figure class="cell research">
      <div
        class="stage"
        tabindex="0"
        role="img"
        aria-label="Cartoon of a person with a visible brain and a boxy robot with a transformer block on its side, facing each other with two looping arrows between them. Each speech bubble says: I am trying to interpret you. On hover or tap, both turn toward you and share one bubble that says: We are trying to interpret you."
        style={`--img-d: url(${url('/images/home/hero-default.png')}); --img-h: url(${url('/images/home/hero-hover.png')})`}
      >
        <div class="art">
          <div class="layer d"></div><div class="layer h"></div>
          <span class="lbl top td" aria-hidden="true">{directions[0].label}</span>
          <span class="lbl bot td" aria-hidden="true">{directions[1].label}</span>
          <span class="t td a" aria-hidden="true">I am trying to interpret you</span>
          <span class="t td b" aria-hidden="true">I am trying to interpret you</span>
          <span class="t th c" aria-hidden="true">We are trying to interpret you</span>
        </div>
      </div>
      <figcaption>My research</figcaption>
    </figure>
    <div class="cell research-text">
      {directions.map((d) => (
        <div class="direction">
          <h2 class="direction-label">{d.label}</h2>
          <p>{d.text}</p>
        </div>
      ))}
      <p class="currently">{currently.before}<a href={currently.link.href} target="_blank" rel="noopener">{currently.link.text}</a>{currently.after}</p>
    </div>
  </section>
  </div>

  <p class="position">
    {blurb.map((part) => (typeof part === 'string' ? part : <a href={part.href} target="_blank" rel="noopener" {...part.event}>{part.text}</a>))}
  </p>

  {news.length > 0 && (
    <section id="news">
      <h2 class="section-label">News</h2>
      <ul class="news-list">
        {news.map((n) => (
          <li>
            <time datetime={n.date.toISOString()}>{formatDate(n.date)}</time>
            <span>{n.link ? <a href={n.link}>{n.text}</a> : n.text}</span>
          </li>
        ))}
      </ul>
    </section>
  )}

</Base>

<style>
  /* Row 1: photo | name, heading, contact (centered on the photo). Row 2: directions | research image (tops aligned). */
  /* --w3 is the width of the picture column: 20rem, less on narrow screens (100cqw is the width of .intro-wrap).
     The research text below is aligned to the picture with it. */
  .intro-wrap { container-type: inline-size; }
  /* The global "section" margin would add 3.5rem above the photo here (the wrapper is main's first child, not the section): none; main's own padding gives the same 2rem under the header as the other pages. */
  .intro { margin-top: 0; }
  .intro { --w3: min(20rem, max(0px, calc(100cqw - 21rem))); display: grid; grid-template-columns: minmax(0, 14rem) minmax(0, 1fr) var(--w3); gap: 2.75rem var(--s4); margin-bottom: var(--s3); }
  .cell { margin: 0; min-width: 0; }
  .photo { grid-column: 1; grid-row: 1; }
  .top-text { grid-column: 2 / 4; grid-row: 1; align-self: center; display: flex; flex-direction: column; gap: var(--s2); }
  .research { grid-column: 3; grid-row: 2; }
  .research-text { grid-column: 1 / 3; grid-row: 2; align-self: start; display: flex; flex-direction: column; gap: var(--s2); }
  .intro-name { margin: 0; font-size: 2.2rem; line-height: 1.1; }
  .internships { margin: 0; }
  .intro-heading { margin: 0; font: 400 1.6rem/1.3 var(--font-body); }
  .photo img { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; object-position: 50% 25%; border-radius: 6px; }
  figcaption { margin-top: 0.35rem; font: italic 0.9rem/1.4 var(--font-body); text-align: right; }
  .direction { margin: 0; }
  .direction-label { margin: 0 0 4px; font: 700 1.4rem/1.3 var(--font-ui); color: var(--text); }
  .direction p { margin: 0; }
  .currently { margin: 0; color: var(--muted); }
  .position { margin: 0; }

  /* Two-frame cartoon: ink PNGs are masks painted in the theme text color, so light and dark both work. */
  .stage { position: relative; width: 100%; container-type: inline-size; padding: 9% 0; cursor: pointer; border-radius: 12px; }
  .art { position: relative; width: 100%; aspect-ratio: 1 / 1; }
  .stage:focus-visible { outline: 2px solid var(--link); outline-offset: 4px; }
  .layer { position: absolute; inset: 0; background: var(--text); mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat; mask-size: 100% 100%; -webkit-mask-size: 100% 100%; transition: opacity 0.28s ease; }
  .layer.d { mask-image: var(--img-d); -webkit-mask-image: var(--img-d); }
  .layer.h { mask-image: var(--img-h); -webkit-mask-image: var(--img-h); opacity: 0; }
  /* Bubble text and arrow labels: the site's sans-serif. Sizes scale with the picture (cqw of .stage); the labels
     sit horizontally above the top arrow and below the bottom one, in the stage's padding. */
  .t, .lbl { position: absolute; font-family: var(--font-ui); color: var(--text); pointer-events: none; transition: opacity 0.28s ease; }
  .lbl { left: 50%; white-space: nowrap; font-weight: 600; font-size: 4.9cqw; line-height: 1.2; }
  .lbl.top { top: 0.4%; transform: translate(-50%, -100%); }
  .lbl.bot { top: 101.2%; transform: translate(-50%, 0); }
  .t { transform: translate(-50%, -50%); text-align: center; line-height: 1.12; text-wrap: balance; font-weight: 400; }
  .t.a { left: 53.3%; top: 23.3%; width: 29%; font-size: 4.0cqw; }
  .t.b { left: 45.7%; top: 79.1%; width: 27%; font-size: 4.0cqw; }
  .t.c { left: 48.6%; top: 16.5%; width: 44%; font-size: 5.3cqw; }
  .t.th { opacity: 0; }
  .stage:focus-visible .layer.d, .stage:focus-visible .td, .stage.on .layer.d, .stage.on .td { opacity: 0; }
  .stage:focus-visible .layer.h, .stage:focus-visible .t.th, .stage.on .layer.h, .stage.on .t.th { opacity: 1; }
  @media (hover: hover) {
    .stage:hover .layer.d, .stage:hover .td { opacity: 0; }
    .stage:hover .layer.h, .stage:hover .t.th { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) { .layer, .t { transition: none; } }

  .contact { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--s1) 1rem; font: 0.98rem/1.5 var(--font-ui); }
  .contact-email { color: var(--muted); }
  .contact-email::before { content: '('; }
  .contact-email::after { content: ')'; }
  .contact .copied:not(:empty) { margin-left: 0.4rem; color: var(--text); }

  .news-list { list-style: none; padding: 0; margin: 0; }
  .news-list li { display: grid; grid-template-columns: 7.5rem 1fr; gap: 0.75rem; margin: 0 0 var(--s1); }


  /* Desktop: the text column is as tall as the picture (min-height = padding + picture + labels = 1.18 × its width),
     so the three blocks spread out evenly. Its first heading sits on the baseline of the top label and its last line
     on the baseline of the bottom label (offsets from the label size, 4.9% of the picture width, and the font metrics). */
  @media (min-width: 40.0625rem) {
    .research-text {
      box-sizing: border-box;
      min-height: calc(var(--w3) * 1.18);
      justify-content: space-between;
      padding-top: max(0px, calc(var(--w3) * 0.0817 - 1.4581rem));
      padding-bottom: max(0px, calc(var(--w3) * 0.0325 - 0.4776rem));
    }
  }

  @media (max-width: 40rem) {
    .intro { grid-template-columns: 1fr; gap: var(--s2); }
    .photo, .top-text, .research, .research-text { grid-column: auto; grid-row: auto; }
    .photo { max-width: 12rem; }
    .research-text { margin-bottom: var(--s1); }
    .news-list li { grid-template-columns: 1fr; gap: 0; }
  }
</style>

<script>
  import { track } from '../lib/track';
  import { copyEmailOnClick } from '../lib/copy-email';

  // "Email" copies the address instead of opening a mail app (email-copy; if the mail app opens instead, email-click).
  copyEmailOnClick(document.querySelector('.contact [data-copy-email]'), document.querySelector('.contact .copied'), {
    copied: () => track('email-copy'),
    fallback: () => track('email-click'),
  });

  // Analytics: bio-reached, once per page load, when half of the bio paragraph is on screen.
  const bio = document.querySelector('.position');
  if (bio && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      io.disconnect();
      track('bio-reached');
    }, { threshold: 0.5 });
    io.observe(bio);
  }

  document.querySelectorAll<HTMLElement>('.stage').forEach((st) => {
    st.addEventListener('click', () => st.classList.toggle('on'));
    st.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); st.classList.toggle('on'); }
    });
  });
</script>
