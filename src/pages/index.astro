---
import Base from '../layouts/Base.astro';
import { formatDate, SITE, url } from '../lib/site';
import { getNews } from '../lib/news';

// Blurb: draft v1 from Alish (Command Center, Oct 21 12:08), word for word.
// Layout (Oct 21 15:23): photo + name + heading line + contact row → directions → position paragraph
// → overview image and News (hidden until they have content). No recent posts on Home.
const headingLine = 'I study the cognitive capabilities and inner workings of AI models.';
const directions = [
  {
    label: 'Neuro- & cognitive science for AI.',
    text: 'Studying AI models the way cognitive scientists study minds: controlled experiments that test what models perceive, what they know, and what they know about themselves.',
  },
  {
    label: 'AI for neuro- & cognitive science.',
    text: 'Building AI systems, such as agents that design and run in-silico experiments, that speed up how we study brains and minds.',
  },
];
const cvPdf = 'https://drive.google.com/file/d/15s30n_O6cHSKVYm-3lO_9BS3PyalfNe9/view?usp=sharing';
const email = 'alish.dipani@gmail.com';
const contact = [
  { label: 'Google Scholar', href: 'https://scholar.google.com/citations?user=i028n20AAAAJ' },
  { label: 'GitHub', href: 'https://github.com/alishdipani' },
  { label: 'X', href: 'https://x.com/alishdipani' },
];

// Shown only once there's something to show (open items are listed in TODO.md).
const overviewImage: { src: string; alt: string } | null = null;
const news = getNews().slice(0, 5);
---
<Base>
  <section class="intro">
    <img class="intro-photo" src={url('/assets/img/AlishDipani_picture.jpg')} alt={SITE.name} width="160" height="160" />
    <div>
      <h1 class="intro-name">{SITE.name}</h1>
      <p class="intro-heading">{headingLine}</p>
      <nav class="contact" aria-label="CV and contact">
        <a href={cvPdf}>CV</a>
        <span><a href={`mailto:${email}`}>Email</a> <span class="contact-email">{email}</span></span>
        {contact.map((c) => <a href={c.href}>{c.label}</a>)}
      </nav>
    </div>
  </section>

  <section class="directions" aria-label="Research directions">
    {directions.map((d) => (
      <div>
        <h2 class="section-label">{d.label.replace(/\.$/, '')}</h2>
        <p>{d.text}</p>
      </div>
    ))}
  </section>

  <p class="position">
    I'm a PhD student and CoCo Fellow at Georgia Tech, advised by Apurva Ratan Murty and Dobromir Rahnev. Before that, I worked on human vision and reading at Northeastern University. I also create course content for and teach at Neuromatch Academy (computational neuroscience, deep learning, NeuroAI).
  </p>

  {overviewImage && (
    <section id="overview">
      <img class="overview" src={url(overviewImage.src)} alt={overviewImage.alt} />
    </section>
  )}

  {news.length > 0 && (
    <section id="news">
      <h2 class="section-label">News</h2>
      <ul class="news-list">
        {news.map((n) => (
          <li>
            <time datetime={n.date.toISOString()}>{formatDate(n.date)}</time>
            <span>{n.link ? <a href={n.link}>{n.text}</a> : n.text}</span>
          </li>
        ))}
      </ul>
    </section>
  )}

</Base>

<style>
  .intro { display: flex; align-items: center; gap: 1.5rem; margin-top: 0; }
  .intro .contact { margin-top: var(--s2); }
  .intro-photo { width: 160px; height: 160px; object-fit: cover; border-radius: 6px; flex: none; }
  .intro-name { margin: 0 0 var(--s1); font-size: 2.2rem; }
  .intro-heading { margin: 0; font: 400 1.35rem/1.4 var(--font-body); }

  .directions { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s3); margin: var(--s3) 0; }
  .directions .section-label { margin-bottom: var(--s1); }
  .directions p { margin: 0; }

  .position { margin: 0; }

  .contact { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--s1) 1rem; font: 0.98rem/1.5 var(--font-ui); }
  .contact-email { color: var(--muted); }
  .contact-email::before { content: '('; }
  .contact-email::after { content: ')'; }

  .overview { display: block; width: 100%; border-radius: 6px; }

  .news-list { list-style: none; padding: 0; margin: 0; }
  .news-list li { display: grid; grid-template-columns: 7.5rem 1fr; gap: 0.75rem; margin: 0 0 var(--s1); }


  @media (max-width: 40rem) {
    .intro { flex-direction: column; align-items: flex-start; gap: var(--s2); }
    .directions { grid-template-columns: 1fr; gap: var(--s2); }
    .news-list li { grid-template-columns: 1fr; gap: 0; }
  }
</style>
