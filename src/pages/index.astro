---
import Base from '../layouts/Base.astro';
import Todo from '../components/Todo.astro';
import { getPosts, formatDate, SITE, url } from '../lib/site';

// Heading line locked by Alish (Oct 21).
const headingLine = 'I study the cognitive capabilities and inner workings of AI models.';
// Research directions from the site brief (Alish, Oct 21).
const directions = ['Neuro- & cognitive science for AI', 'AI for neuro- & cognitive science'];
const contact = [
  { label: 'Email', href: 'mailto:alish.dipani@gmail.com', text: 'alish.dipani@gmail.com' },
  { label: 'Google Scholar', href: 'https://scholar.google.com/citations?user=i028n20AAAAJ' },
  { label: 'GitHub', href: 'https://github.com/alishdipani' },
  { label: 'X', href: 'https://x.com/alishdipani' },
];
const recentPosts = (await getPosts()).slice(0, 3);
---
<Base>
  <section id="about">
    <img src={url('/assets/img/AlishDipani_picture.jpg')} alt={SITE.name} width="200" />
    <h1>{SITE.name}</h1>
    <p class="lead">{headingLine}</p>
    <ul>
      {directions.map((d) => (
        <li>
          <strong>{d}</strong>
          <Todo>short explainer.</Todo>
        </li>
      ))}
    </ul>
    <Todo>2–3 lines on current position, foundations and past places.</Todo>
    <p><a class="button" href={url('/cv/')}>CV</a> <a href="#contact">Contact</a></p>
  </section>

  <section id="overview">
    <h2>Overview</h2>
    <Todo>overview image.</Todo>
  </section>

  <section id="news">
    <h2>News</h2>
    <Todo>recent news items (including papers).</Todo>
  </section>

  <section id="posts">
    <h2>Recent posts</h2>
    <ul class="post-list">
      {recentPosts.map((post) => (
        <li>
          <a href={url(`/blog/${post.id}/`)}>{post.data.title}</a>
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        </li>
      ))}
    </ul>
    <p><a href={url('/blog/')}>All posts →</a></p>
  </section>

  <section id="contact">
    <h2>Contact</h2>
    <ul>
      {contact.map((c) => (
        <li>{c.text ? <>{c.label}: <a href={c.href}>{c.text}</a></> : <a href={c.href}>{c.label}</a>}</li>
      ))}
    </ul>
  </section>

  <section id="footnotes">
    <h2>Footnotes</h2>
    <Todo>footnotes.</Todo>
  </section>
</Base>
