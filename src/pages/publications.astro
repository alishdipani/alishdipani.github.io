---
import '@fontsource/source-serif-4/latin-500.css';
import '../styles/post.css';
import Base from '../layouts/Base.astro';
import Contents from '../components/Contents.astro';
import { GROUPS, getPublications, type Author, type Publication } from '../lib/publications';
import { SITE } from '../lib/site';

// Entry style: Alish's decision (Command Center, Oct 21 23:15), same in both sections.
//   [n]  Title (links to the paper or abstract)
//        Authors (APA short form)
//        Venue, year · status · links
const pubs = getPublications();
// Empty groups are not shown. Numbering restarts in each group and counts up from the oldest
// entry, so adding a paper never renumbers older ones.
const groups = GROUPS.map((g) => ({ ...g, slug: `${g.id}s`, items: pubs.filter((p) => p.group === g.id) })).filter((g) => g.items.length);
const hasEqual = pubs.some((p) => p.authors.some((a) => a.equal));
const hasHighlight = pubs.some((p) => p.highlight);
const contents = groups.map((g) => ({ slug: g.slug, text: g.title }));

// Authors: the full list when it fits on one line (about AUTHOR_LINE characters on a desktop
// screen). Otherwise, when Alish is among the first four authors: the first four, …, the last author
// (Alish, Oct 22). Otherwise the first two authors, …, Alish, …, the last author; and if that is still
// too long, only the first author before Alish (Alish, Oct 21). "and others" in the bib ends in "…".
const AUTHOR_LINE = 105;
type Shown = Author | '…';
const lineLength = (shown: Shown[]) =>
  shown.reduce((n, a, j) => n + (a === '…' ? 1 : a.apa.length + (a.equal ? 1 : 0)) + (j ? 2 : 0), 0) + 2;
function pick(list: Author[], keep: number[], others: boolean): Shown[] {
  const shown: Shown[] = [];
  let last = -1;
  for (const i of [...new Set(keep)].filter((i) => i >= 0 && i < list.length).sort((a, b) => a - b)) {
    if (i > last + 1) shown.push('…');
    shown.push(list[i]);
    last = i;
  }
  if (others || last < list.length - 1) shown.push('…');
  return shown;
}
function shownAuthors(authors: Author[]): Shown[] {
  // "others" in the middle of the bib list: some authors aren't listed there; show the list as given.
  const gap = authors.findIndex((a) => a.name === 'others');
  if (gap >= 0 && gap < authors.length - 1) return authors.map((a) => (a.name === 'others' ? '…' : a));
  const others = authors.some((a) => a.name === 'others');
  const list = authors.filter((a) => a.name !== 'others');
  if (!others && lineLength(list) <= AUTHOR_LINE) return list;
  const self = list.findIndex((a) => a.name === SITE.name);
  const tail = others ? [] : [list.length - 1];
  if (self >= 0 && self < 4) {
    const shown = pick(list, [0, 1, 2, 3, ...tail], others);
    if (lineLength(shown) <= AUTHOR_LINE) return shown;
  }
  for (const first of [[0, 1], [0]]) {
    const shown = pick(list, [...first, self, ...tail], others);
    if (lineLength(shown) <= AUTHOR_LINE) return shown;
  }
  return pick(list, [0, self, ...tail], others);
}
// Separator before item j: ", " between authors, " " after "…", ", & " before the last author of
// a complete list (APA).
function sep(j: number, all: Shown[]) {
  if (j === 0) return '';
  if (all[j - 1] === '…') return ' ';
  if (all[j] !== '…' && j === all.length - 1 && !all.includes('…')) return ', & ';
  return ', ';
}

// Venue names are shown in full (Alish, chat, Oct 21); PNAS gets its abbreviation and the commentary note.
const VENUE: [RegExp, string][] = [
  [/^Proceedings of the National Academy of Sciences \(Commentary\)$/, 'Proceedings of the National Academy of Sciences (PNAS), commentary'],
];
const venueName = (venue: string) => VENUE.find(([re]) => re.test(venue))?.[1] ?? venue;

// Status after the venue: the entry's status, else "Preprint" for preprint-server entries.
const statusOf = (p: Publication, group: string) =>
  group === 'publication' ? p.status ?? (p.preprint ? 'Preprint' : undefined) : p.status;
// Link labels: for presentations, the main link is the abstract and a PDF is the paper.
const linkLabel = (label: string, group: string) =>
  group === 'presentation' ? ({ Paper: 'Abstract', PDF: 'Paper' } as Record<string, string>)[label] ?? label : label;
---
<Base title="Publications" wide>
  <div class="post-layout pubs-page has-toc">
    <Contents items={contents} variant="side" />

    <div class="post">
      <h1 class="sr-only">Publications</h1>
      <!-- One line, same style as the Blog note; wording per Alish, Oct 21 23:05. -->
      <p class="page-note">
        Latest list on <a href="https://scholar.google.com/citations?user=i028n20AAAAJ" target="_blank" rel="noopener">Google Scholar</a>.{hasEqual && <> * denotes equal contribution</>}{hasHighlight && <><span class="legend-sep" aria-hidden="true">·</span><span class="swatch" aria-hidden="true"></span>Highlighted: representative work</>}
      </p>
      <Contents items={contents} variant="inline" />

      {groups.map((g) => (
        <section class="pub-group">
          <h2 class="section-label" id={g.slug}>{g.title}</h2>
          <ol class="pubs">
            {g.items.map((p, i) => {
              const authors = shownAuthors(p.authors);
              const status = statusOf(p, g.id);
              const comma = status ? status.indexOf(', ') : -1;
              const title = p.title.replace(/\.$/, '');
              return (
                <li class:list={['pub', p.highlight && 'highlight']} id={p.key}>
                  <span class="pub-num">[{g.items.length - i}]</span>
                  <div class="pub-body">
                    <p class="pub-title">{p.url ? <a href={p.url} target="_blank" rel="noopener">{title}</a> : title}</p>
                    <p class="pub-authors">
                      {authors.map((a, j) => (
                        <>{sep(j, authors)}{a === '…' ? '…' : a.name === SITE.name ? <span class="self">{a.apa}</span> : a.apa}{a !== '…' && a.equal && '*'}</>
                      ))}
                    </p>
                    <div class="pub-venue">
                      <span>
                        {p.kind && g.id === 'presentation' && <>{p.kind}, </>}
                        <em>{venueName(p.venue)}</em>{g.id === 'presentation' ? ' ' : ', '}{p.year}
                      </span>
                      {status && (
                        <span class="dot">
                          {p.statusUrl && comma > 0 ? (
                            <>{status.slice(0, comma + 2)}<a href={p.statusUrl} target="_blank" rel="noopener">{status.slice(comma + 2)}</a></>
                          ) : status}
                        </span>
                      )}
                      {p.links.map((l) => <span class="dot"><a class="pub-link" href={l.href} target="_blank" rel="noopener">{linkLabel(l.label, g.id)}</a></span>)}
                      {g.id === 'publication' && (
                        <details class="bibtex dot">
                          <summary class="pub-link">BibTeX</summary>
                          <div class="bibtex-box">
                            <pre><code>{p.bibtex}</code></pre>
                            <button type="button" class="pub-link copy" data-copy>Copy</button>
                          </div>
                        </details>
                      )}
                    </div>
                    {p.summary && g.id === 'publication' && <p class="pub-summary">{p.summary}</p>}
                  </div>
                </li>
              );
            })}
          </ol>
        </section>
      ))}
    </div>
  </div>
</Base>

<style>
  .pub-group { margin: 0; }
  /* A thin rule between Publications and Presentations instead of blank space (Alish, chat). */
  .pub-group + .pub-group { margin-top: var(--s3); padding-top: var(--s3); border-top: 1px solid var(--border); }
  .pub-group h2 { scroll-margin-top: var(--s2); }
  .pubs { list-style: none; padding: 0; margin: 0; }

  /* One entry: number in a narrow gutter, then three lines ~2px apart; ~20px between entries.
     Every entry is a tile with a little padding (cancelled by negative side margins, so the text stays aligned
     with the headings); highlighted entries (representative work) get a subtle tint. */
  .pub { display: grid; grid-template-columns: 2.1rem minmax(0, 1fr); margin: 0 -0.75rem 0.25rem; padding: 0.5rem 0.75rem; border-radius: 8px; }
  .pub:last-child { margin-bottom: 0; }
  .pub.highlight { background: var(--highlight); }
  .pub p { margin: 0; }
  .pub-num { font: 400 0.8rem/1.55rem var(--font-ui); color: var(--muted); opacity: 0.75; font-variant-numeric: tabular-nums; }
  .pub-body > * + * { margin-top: 2px; }

  .pub-title { font: 500 1.0625rem/1.45 var(--font-body); color: var(--text); }
  .pub-title a { color: inherit; text-decoration-line: none; }
  .pub-title a:hover, .pub-title a:focus-visible { text-decoration-line: underline; }

  .pub-authors, .pub-venue { font: 400 0.875rem/1.5 var(--font-ui); color: var(--muted); }
  .pub-authors .self { color: var(--text); font-weight: 600; }

  /* Legend in the note: a small square in the highlight tint */
  .legend-sep { margin: 0 0.45em; color: var(--border); font-weight: 700; }
  .swatch { display: inline-block; width: 0.8em; height: 0.8em; margin-right: 0.35em; vertical-align: -0.05em; border-radius: 2px; background: var(--highlight); box-shadow: inset 0 0 0 1px var(--border); }

  .pub-venue em { font-family: var(--font-body); font-style: italic; }
  .pub-venue a { text-decoration-line: none; }
  .pub-venue a:hover, .pub-venue a:focus-visible { text-decoration-line: underline; }
  /* Light gray middle dot between items */
  .dot::before { content: '·'; margin: 0 0.45em; color: var(--border); font-weight: 700; }
  .pub-link { color: var(--link); font: inherit; background: none; border: 0; padding: 0; cursor: pointer; }

  .bibtex { display: inline; }
  .bibtex summary { display: inline; list-style: none; }
  .bibtex summary::-webkit-details-marker { display: none; }
  .bibtex summary:hover, .bibtex summary:focus-visible { text-decoration: underline; }
  .bibtex-box { position: relative; margin-top: 0.4rem; }
  .bibtex-box pre { background: var(--surface); margin: 0; padding: 0.75rem 1rem; font-size: 0.78rem; white-space: pre-wrap; word-break: break-word; }
  .bibtex-box .copy { position: absolute; top: 0.4rem; right: 0.6rem; font-size: 0.8rem; }

  .pub-summary { font: 0.9rem/1.5 var(--font-body); color: var(--muted); }
</style>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    btn.addEventListener('click', async () => {
      const text = btn.parentElement?.querySelector('code')?.textContent ?? '';
      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = 'Copied';
      } catch {
        btn.textContent = 'Select and copy';
      }
      setTimeout(() => (btn.textContent = 'Copy'), 1500);
    });
  }
</script>
