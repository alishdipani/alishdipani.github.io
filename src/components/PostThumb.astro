---
// Small square NGC thumbnail for post lists (Decision Oct 21: about 56 px; the file is 112 px for sharp screens).
// Posts without an NGC thumbnail get a quiet neutral square so titles stay aligned.
import { url } from '../lib/site';

interface Props {
  ngc?: { name: string; thumb?: string };
}
const { ngc } = Astro.props;
---
{ngc?.thumb ? (
  <img class="post-thumb" src={url(ngc.thumb)} alt="" width="56" height="56" loading="lazy" />
) : (
  <span class="post-thumb post-thumb-empty" aria-hidden="true"></span>
)}
