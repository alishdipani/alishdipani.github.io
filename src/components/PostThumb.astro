---
// Small square NGC thumbnail for post lists (Decision Oct 21 14:25: about 42 px; the 112 px file keeps it sharp).
// Posts without an NGC thumbnail get a quiet neutral square so titles stay aligned.
import { url } from '../lib/site';

interface Props {
  ngc?: { name: string; thumb?: string };
}
const { ngc } = Astro.props;
---
{ngc?.thumb ? (
  <img class="post-thumb" src={url(ngc.thumb)} alt="" width="42" height="42" loading="lazy" />
) : (
  <span class="post-thumb post-thumb-empty" aria-hidden="true"></span>
)}
