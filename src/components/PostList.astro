---
// List of posts: a small NGC thumbnail (about 42 px) on the left, then title and date.
// Used on Home and the blog index.
import PostThumb from './PostThumb.astro';
import { formatDate, url } from '../lib/site';
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'blog'>[];
}
const { posts } = Astro.props;
---
<ul class="post-list post-list-thumbs">
  {posts.map((post) => (
    <li>
      <PostThumb ngc={post.data.ngc} />
      <div>
        <a href={url(`/blog/${post.id}/`)}>{post.data.title}</a>
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      </div>
    </li>
  ))}
</ul>
